# Añade estos bloques dentro del server {} de javierpineda.es en tu VPS Nginx
# (normalmente en /etc/nginx/sites-available/javierpineda.es)

    # ── Frontend React ────────────────────────────────────────────────────────
    location /clinicadentalAlamillo/ {
        proxy_pass         http://127.0.0.1:3000/clinicadentalAlamillo/;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # ── Backend Spring Boot API ───────────────────────────────────────────────
    location /api/ {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

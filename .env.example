# ── Base de datos (MariaDB externo en el VPS) ─────────────────────────────────
DB_URL=jdbc:mariadb://host.docker.internal:3306/CAlamillo?useUnicode=true&characterEncoding=utf8&serverTimezone=Europe/Madrid
DB_USER=tu_usuario_db
DB_PASSWORD=tu_contraseña_db

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Genera con: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_un_secreto_de_64_chars_minimo_en_produccion

# Genera con: openssl rand -hex 16  (exactamente 32 chars hex = 128 bits)
HEALTH_ENCRYPTION_KEY=cambia_esto_clave_aes_256

# ── CORS / URLs ───────────────────────────────────────────────────────────────
CORS_ORIGINS=https://javierpineda.es
FRONTEND_URL=https://javierpineda.es/clinicadentalalamillo

# ── Email (opcional) ──────────────────────────────────────────────────────────
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
